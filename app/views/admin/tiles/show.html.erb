<h1><%= admin_title @tile %></h1>

<div class="row">
  <div class="col-md-6">
    <%= render 'details', tile: @tile %>
    <%= render 'subscription_info', tile: @tile %>
    <%= render 'posts', tile: @tile %>
  </div>
  <div class="col-md-6">
    <%= render 'static_pages/w3w_map', tiles: [@tile], focus_tiles: [@tile] %>

    <p>
      <%= render 'layouts/copy_to_clipboard', copytext: "<iframe width=\"100%\" height=\"500px\" src=\"#{embed_tile_url(@tile, legend: 1)}\"></iframe>", copycta: 'Copy Embed Code', cta_width: '200px' %>
    </p>
  </div>
</div>
