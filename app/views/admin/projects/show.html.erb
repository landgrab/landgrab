<%= admin_page_header(admin_title(@project)) do %>
  <%= admin_edit_button(@project) %>
  <%= render 'admin/posts/new_post_link', postable: @project, class: 'btn btn-primary' %>
<% end %>

<%= render 'details', project: @project %>

<h2>Plots in this Project</h2>
<%= render 'admin/plots/table', project: @project, plots: @project.plots %>

<h2>Posts about this Project</h2>
<%= render 'admin/posts/table', posts: @project.posts, cols: %w[title preview author published] %>

<h2>Prices for this Project</h2>
<%= render 'admin/prices/table', project: @project %>
