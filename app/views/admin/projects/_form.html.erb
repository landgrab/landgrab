<%= form_with(model: [:admin, project], local: true) do |form| %>
  <%= render 'layouts/form_errors', errors: project.errors %>

  <div class="row mb-3 g-3 align-items-center">
    <div class="col-sm-2">
      <%= form.label :title, class: 'col-form-label' %>
    </div>
    <div class="col-sm-5">
      <%= form.text_field :title,
                          required: true,
                          placeholder: 'My First Project',
                          class: 'form-control',
                          aria: { describedby: 'titleHelp' } %>
    </div>
    <div class="col-sm-5">
      <span id="titleHelp" class="form-text">
        Name for this project
      </span>
    </div>
  </div>

  <div class="row mb-3 g-3 align-items-center">
    <div class="col-sm-2">
      <%= form.label :description, class: 'col-form-label' %>
    </div>
    <div class="col-sm-5">
      <%= form.text_area :description,
                         required: true,
                         placeholder: 'We are working to rewild ...',
                         class: 'form-control',
                         rows: 6,
                         aria: { describedby: 'descriptionHelp' } %>
    </div>
    <div class="col-sm-5">
      <span id="descriptionHelp" class="form-text">
        Detail about the project, shown on project page
      </span>
    </div>
  </div>

  <div class="row mb-3 g-3 align-items-center">
    <div class="col-sm-2">
      <%= form.label :website, 'Website URL', class: 'col-form-label' %>
    </div>
    <div class="col-sm-5">
      <%= form.text_field :website,
                          class: 'form-control',
                          placeholder: 'https://www.example.com',
                          aria: { describedby: 'websiteHelp' } %>
    </div>
    <div class="col-sm-5">
      <span id="websiteHelp" class="form-text">
        URL of the project website which the project logo will link to
      </span>
    </div>
  </div>

  <%= render 'admin/shared/image_field',
             form:,
             name: :hero_image,
             url_attribute: :hero_image_url,
             label: 'Hero Image',
             help: 'A wide image to be used in the background of the project page.' %>

  <%= render 'admin/shared/image_field',
             form:,
             name: :logo,
             url_attribute: :logo_url,
             label: 'Logo',
             help: 'A smaller image / icon for the project.' %>

  <div class="row mb-3 g-3 align-items-center">
    <div class="col-sm-2">
      <%= form.label :welcome_text, class: 'col-form-label' %>
    </div>
    <div class="col-sm-5">
      <%= form.text_area :welcome_text,
                        required: true,
                        class: 'form-control',
                        placeholder: "Welcome to the members area for the project! Now you've subscribed, you can ...",
                        rows: 6,
                        aria: { describedby: 'welcomeTextHelp' } %>
    </div>
    <div class="col-sm-5">
      <span id="welcomeTextHelp" class="form-text">
        Message shown after a user subscribes
      </span>
    </div>
  </div>

  <div class="row mb-3 g-3 align-items-center">
    <div class="col-sm-2">
      <%= form.label :subscriber_benefits, class: 'col-form-label' %>
    </div>
    <div class="col-sm-5">
      <%= form.text_area :subscriber_benefits,
                        class: 'form-control',
                        placeholder: "You should really sponsor a tile here because:\n- Reason 1\n- Reason 2\n- Reason 3",
                        rows: 6,
                        aria: { describedby: 'subscriberBenefitsHelp' } %>
    </div>
    <div class="col-sm-5">
      <span id="subscriberBenefitsHelp" class="form-text">
        Shown to non-sponsoring (or unregistered) users to encourage subscribing
      </span>
    </div>
  </div>

  <div class="row mb-3 g-3 align-items-center">
    <div class="col-sm-2">
      <%= form.label :public, class: 'col-form-label' %>
    </div>
    <div class="col-sm-5">
      <%= form.check_box :public,
                         class: 'form-check-input',
                         aria: { describedby: 'publicHelp' } %>
    </div>
    <div class="col-sm-5">
      <span id="publicHelp" class="form-text">
        Tick to show this project on the explore page and public projects list
      </span>
    </div>
  </div>

  <%= form.submit class: 'btn btn-primary' %>
<% end %>
