<h1><%= admin_title Subscription %></h1>

<p>
  Subscriptions grant users access to the corresponding tile (once chosen).
</p>

<%= render 'filters' %>

<p>
  <%= page_entries_info @subscriptions %>
  <% if filtered? %>
    matching selected filters
  <% end %>
  -
  <%= link_to 'download csv', admin_subscriptions_path(format: :csv, params: request.query_parameters) %>
</p>

<%= render 'table', subscriptions: @subscriptions %>

<%= paginate @subscriptions, theme: 'bootstrap-5' %>

<p>
  Users can subscribe to an available tile from the tile's details page.
</p>
