<%= admin_page_header(admin_title(Post)) do %>
  <%= admin_new_button(Post) %>
<% end %>

<p>
  Posts provide subscribers with updates or news about their projects, plots or tiles.
</p>

<%= render 'filters' %>

<p>
  <%= page_entries_info @posts %>
  <% if filtered? %>
    matching selected filters
  <% end %>
  -
  <%= link_to 'download csv', admin_posts_path(format: :csv, params: request.query_parameters) %>
</p>

<%= render 'table', posts: @posts if @posts.any? %>

<%= paginate @posts, theme: 'bootstrap-5' %>
