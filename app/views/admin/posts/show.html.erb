<%= admin_page_header(admin_title(@post)) do %>
  <%= admin_edit_button(@post) %>
<% end %>

<%= render 'details', post: @post %>

<h2 class="mt-3">
  Post Associations
</h2>

<p>
  Any user with an active subscription to an associated tile/plot/project
  or who is in an associated team,
  will be able to see this post.
</p>

<%= render 'associations', post_associations: @post.post_associations %>
