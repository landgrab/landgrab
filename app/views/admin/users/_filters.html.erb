<%= form_tag(admin_users_path, method: :get, class: 'row g-3 mb-3') do %>
  <%= render_filter_text(:first_name, col: 3) %>
  <%= render_filter_text(:last_name, col: 3) %>
  <%= render_filter_text(:email, col: 3) %>
  <%= render_filter_text(:stripe_customer_id, 'Stripe ID', col: 3) %>

  <div class="col-sm-5">
    <%= label_tag :redeemed_subscription_to_plot, 'Redeemed Subscription to Plot', class: 'visually-hidden' %>
    <%= select_tag :redeemed_subscription_to_plot, option_groups_from_collection_for_select(Project.includes(:plots).order(:title), :plots, :title, :hashid, :title, params[:redeemed_subscription_to_plot]),
                                         { include_blank: '[ Redeemed Subscription to Plot ]', multiple: true, size: 2, class: 'form-select' } %>
  </div>

  <div class="col-sm-5">
    <%= label_tag :team, 'Team', class: 'visually-hidden' %>
    <%= select_tag :team, options_from_collection_for_select(Team.order(:title), :hashid, :title, params[:team]),
                          { include_blank: '[ Any/no team ]', class: 'form-select' } %>
  </div>

  <%= render_filter_text(:referrer, 'Referrer User ID', col: 2) %>

  <% if params[:can_view_post].present? %>
    <div class="col-12">
      <%= hidden_field_tag :can_view_post, params[:can_view_post] %>
      <span class="badge text-bg-secondary">Can view post: <%= Post.find_by_hashid!(params[:can_view_post]).title %></span>
      <%= link_to 'Clear', admin_users_path(request.query_parameters.except('can_view_post')), class: 'small ms-1' %>
    </div>
  <% end %>

  <%= render_filter_submit %>
<% end %>
