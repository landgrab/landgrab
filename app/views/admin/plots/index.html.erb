<%= admin_page_header(admin_title(Plot)) do %>
  <%= admin_new_button(Plot) %>
<% end %>

<p>
  Plots are collections of tiles covering an area.
</p>

<%= render 'filters' %>

<p>
  <%= page_entries_info @plots %>
  <% if @project.present? %>
    from the <%= link_to @project.title, admin_project_path(@project) %> project
  <% end %>
  <% if filtered?(:project) %>
    matching selected filters.
  <% end %>
  -
  <%= link_to 'download csv', admin_plots_path(format: :csv, params: request.query_parameters) %>
</p>

<%= render 'table', plots: @plots if @plots.any? %>

<%= paginate @plots, theme: 'bootstrap-5' %>
