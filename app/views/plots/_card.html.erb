<% featured ||= false %>
<%# tile_count and available_tile_count can be passed in when counted for many plots at once %>
<% tile_count = local_assigns.fetch(:tile_count) { plot.tiles.size } %>
<% available_tile_count = local_assigns.fetch(:available_tile_count) { plot.non_subscribed_tiles.size } %>

<div class="card mb-3">
  <%= image_tag plot.hero_image_for_display(:web), class: 'card-img-top img-fluid', alt: "Hero image for #{plot.title} plot" %>
  <% if featured %>
    <div class="card-header">
      <span class="badge text-bg-warning">Featured Plot</span>
    </div>
  <% end %>
  <div class="card-body">
    <h5 class="card-title"><%= plot.title %></h5>
    <p><%= plot.description %></p>
    <p class="card-text">
      <% if available_tile_count.zero? %>
        There are no tiles available
      <% else %>
        <%= available_tile_count %>
        of
        <%= tile_count %>
        tiles available
      <% end %>
    </p>
    <%= link_to 'View Plot',
                plot_path(plot),
                class: "btn btn-#{featured ? 'warning' : 'primary'} stretched-link" %>
  </div>
</div>
