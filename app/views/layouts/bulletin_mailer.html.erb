<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%# premailer-rails turns these styles into inline styles, which email clients need %>
    <style>
      body { margin: 0; padding: 0; background-color: #f4f4f4; font-family: Helvetica, Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #212529; }
      table.wrapper { width: 100%; background-color: #f4f4f4; }
      table.container { width: 100%; max-width: 600px; background-color: #ffffff; }
      td.content { padding: 24px; }
      h1, h2 { margin: 0 0 8px 0; line-height: 1.25; }
      h2 { font-size: 20px; }
      p { margin: 0 0 16px 0; }
      a { color: #0d6efd; }
      img { max-width: 100%; height: auto; border: 0; }
      ul, ol { margin: 0 0 16px 0; padding-left: 24px; }
      .post { margin: 0 0 24px 0; padding: 16px 0 0 0; border-top: 1px solid #dee2e6; }
      .footer { font-size: 13px; color: #6c757d; }
      .footer a { color: #6c757d; }
    </style>
  </head>

  <body>
    <table class="wrapper" role="presentation" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <table class="container" role="presentation" cellpadding="0" cellspacing="0">
            <tr>
              <td class="content">
                <%= yield %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
