<%
tiles ||= []
plot ||= nil
subject ||= current_user
focus_tiles ||= []
focus_title ||= 'This tile'
tile_action ||= nil
plot_overview ||= nil
hide_legend ||= false
legend_style ||= :list # or :banner, to show the legend in a thin strip along the bottom of the map
map_height ||= '500px'
map_id = "map-#{SecureRandom.hex(4)}"
highlighter ||= TileHighlightService.new(viewer: current_user, subject:)
tile_map = TileMap.new(tiles:, plot:, highlighter:, focus_tiles:, focus_title:)
%>

<% unless @w3w_map_scripts_loaded %>
  <% @w3w_map_scripts_loaded = true %>
  <script src="https://assets.what3words.com/sdk/v3/what3words.js?key=<%= ENV.fetch('WHAT3WORDS_API_KEY') %>"></script>
  <%= render 'layouts/leaflet_imports' %>
  <%= render 'layouts/leaflet_helpers' %>
<% end %>

<% tiles_geojson = "[#{tile_map.tiles.map { |tile| tile.tap { tile.map_action = tile_action }.to_geojson }.join(', ')}]" %>
<% map_data = { tiles: tiles_geojson, plots: plot_overview&.to_geojson } %>
<% legend = hide_legend ? [] : tile_map.legend %>
<% if legend_style == :banner %>
  <%# The map fills whatever height the banner (if any) leaves %>
  <%= tag.div style: "display: flex; flex-direction: column; height: #{map_height}" do %>
    <%= tag.div id: map_id, style: 'width: 100%; flex: 1 1 0; min-height: 0', data: map_data %>
    <% if legend.any? %>
      <%= render 'static_pages/map_legend_banner', legend: %>
    <% end %>
  <% end %>
<% else %>
  <%= tag.div id: map_id, style: "width: 100%; height: #{map_height}", class: 'mb-3', data: map_data %>

  <% unless hide_legend %>
    <%= render 'static_pages/map_legend', legend: %>
  <% end %>
<% end %>

<script>
  (function() {
    function onEachFeature(feature, layer) {
      if (feature.properties && feature.properties.popupContent) {
        layer.bindPopup(feature.properties.popupContent);
      } else if (feature.properties && feature.properties.link) {
        layer.on({
          click: () => { location = feature.properties.link; }
        });
      }
    }

    function tileStyle(feature) {
      // Style docs: https://leafletjs.com/reference.html#path-option
      const properties = feature.geometry.properties || {};
      const style = { color: 'black', weight: 2, opacity: 0.65, fill: true, fillOpacity: 0.8, fillColor: properties.colour };
      if (properties.border) {
        return {...style, ...{ color: properties.border, weight: 4, opacity: 1 }};
      }
      return style;
    };

    var map = L.map('<%= map_id %>', { gestureHandling: true });

    addFullscreenButton(map);
    addAllLayers(map);

    var mapElement = document.getElementById('<%= map_id %>');
    var allTilesGeoJson = JSON.parse(mapElement.dataset.tiles);
    var tiles = L.geoJSON(allTilesGeoJson, { onEachFeature: onEachFeature, style: tileStyle });

    <% if plot_overview %>
      // Plot overview: open on plot outlines. Zoomed in deep enough, each plot in view
      // swaps its outline for its tiles, and back again on zooming out. Clicking a plot
      // zooms to it.
      var tilesByPlot = {};
      allTilesGeoJson.forEach((tile) => {
        const plotId = tile.properties.plot_id;
        (tilesByPlot[plotId] = tilesByPlot[plotId] || []).push(tile);
      });

      var plotTiles = {}; // Each plot's tiles layer, built the first time it's shown

      var plotsGeoJson = JSON.parse(mapElement.dataset.plots);
      var outlines = L.geoJSON(plotsGeoJson, {
        style: function(feature) {
          const colour = feature.properties.colour;
          return { color: colour, weight: 3, opacity: 1, fill: true, fillColor: colour, fillOpacity: 0.5 };
        },
        onEachFeature: function(feature, layer) {
          layer.bindTooltip(feature.properties.label, { permanent: true, direction: 'center' });
          layer.on({ click: () => zoomToPlot(layer) });
        }
      }).addTo(map);
      var allOutlines = outlines.getLayers();

      var overviewBounds = outlines.getBounds();
      var plotZooms = allOutlines.map((layer) => map.getBoundsZoom(layer.getBounds()));
      // Zoom at which plots show their tiles: deep enough that every plot fills the map,
      // yet past the overview (unless there's one plot), and never beyond the map's
      // maximum zoom.
      var tilesZoom = Math.min(
        plotZooms.length > 1 ? Math.max(Math.min(...plotZooms), map.getBoundsZoom(overviewBounds) + 1) : plotZooms[0],
        map.getMaxZoom()
      );

      function tilesFor(outline) {
        const plotId = outline.feature.properties.id;
        return plotTiles[plotId] = plotTiles[plotId] ||
          L.geoJSON(tilesByPlot[plotId] || [], { onEachFeature: onEachFeature, style: tileStyle });
      }

      function showTiles(outline) {
        if (!outlines.hasLayer(outline)) { return; }

        outlines.removeLayer(outline);
        tilesFor(outline).addTo(map);
      }

      function showOutline(outline) {
        if (outlines.hasLayer(outline)) { return; }

        map.removeLayer(tilesFor(outline));
        outlines.addLayer(outline);
      }

      function showPlotsForView() {
        const showingTiles = map.getZoom() >= tilesZoom;
        const view = map.getBounds();
        allOutlines.forEach((outline) => {
          if (showingTiles && view.intersects(outline.getBounds())) {
            showTiles(outline);
          } else {
            showOutline(outline);
          }
        });
      }

      function zoomToPlot(outline) {
        const bounds = outline.getBounds();
        map.setView(bounds.getCenter(), Math.max(map.getBoundsZoom(bounds), tilesZoom));
      }

      if (plotZooms.length > 1) {
        map.fitBounds(overviewBounds, { maxZoom: tilesZoom - 1 });
        map.on('moveend', showPlotsForView);
      } else {
        showTiles(allOutlines[0]);
        zoomToPlot(allOutlines[0]);
      }
    <% elsif plot.present? %>
      tiles.addTo(map);
      // Fit map to plot bounds
      var latlngs = <%= plot.polygon.coordinates[0][0...-1].map(&:reverse) %>;
      var polygon = L.polygon(latlngs); // Note: not adding to map
      map.fitBounds(polygon.getBounds());
    <% else %>
      // Fit map to tile bounds
      tiles.addTo(map);
      map.fitBounds(tiles.getBounds());
    <% end %>

    var grid_layer;

    function drawGrid() {
      const zoom = map.getZoom();
      const loadFeatures = zoom > 17;

      if (loadFeatures) { // Zoom level is high enough
        var ne = map.getBounds().getNorthEast();
        var sw = map.getBounds().getSouthWest();

        // Call the what3words Grid API to obtain the grid squares within the current visible bounding box
        what3words.api
          .gridSectionGeoJson({
            southwest: {
              lat: sw.lat,
              lng: sw.lng
            },
            northeast: {
              lat: ne.lat,
              lng: ne.lng
            }
          }).then(function(data) {
            // If the grid layer is already present, remove it as it will need to be replaced by the new grid section
            if (typeof grid_layer !== 'undefined') {
              map.removeLayer(grid_layer);
            }

            // Create a new GeoJSON layer, based on the GeoJSON returned from the what3words API
            grid_layer = L.geoJSON(data, {
              style: function() {
                return {
                  color: '#777',
                  stroke: true,
                  weight: 0.5
                };
              }
            }).addTo(map);
          }).catch(console.error);
      } else {
        // If the grid layer already exists, remove it as the zoom level no longer requires the grid to be displayed
        if (typeof grid_layer !== 'undefined') {
          map.removeLayer(grid_layer);
        }
      }
    }

    map.whenReady(drawGrid);
    map.on('move', drawGrid);
  })();
</script>
