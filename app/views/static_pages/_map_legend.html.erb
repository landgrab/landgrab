<% legend ||= [] %>

<ul class="list-inline">
  <% legend.each do |entry| %>
    <li class="list-inline-item">
      <span class="tile-legend" style="background-color: <%= entry.fetch(:fill) %>;<% if entry.fetch(:border) %> border: 4px solid <%= entry.fetch(:border) %>;<% end %>">&nbsp;</span>
      <%= entry.fetch(:title) %>
    </li>
  <% end %>
</ul>

<style>
.tile-legend {
  height: 30px;
  width: 30px;
  border: 2px solid black;
  outline: 1px solid black;
  display: inline-block;
  opacity: 0.85;
}
</style>
