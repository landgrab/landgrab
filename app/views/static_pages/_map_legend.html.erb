<% legend ||= [] %>

<ul class="list-inline">
  <% legend.each do |entry| %>
    <li class="list-inline-item">
      <span class="tile-legend<%= ' tile-legend-any-fill' if entry.fetch(:fill).nil? %>"
            style="<% if entry.fetch(:fill) %>background-color: <%= entry.fetch(:fill) %>;<% end %><% if entry.fetch(:border) %> border: 4px solid <%= entry.fetch(:border) %>;<% end %>">&nbsp;</span>
      <%= entry.fetch(:title) %>
    </li>
  <% end %>
</ul>

<style>
.tile-legend {
  height: 30px;
  width: 30px;
  border: 2px solid black;
  outline: 1px solid black;
  display: inline-block;
  opacity: 0.85;
}
/* Outline-only entries: stripes stand for "any fill colour" */
.tile-legend-any-fill {
  background: repeating-linear-gradient(45deg, #8a8a8a 0 4px, #c4c4c4 4px 8px);
}
</style>
